{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "citations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "locator": {
            "minLength": 1,
            "type": "string"
          },
          "source_id": {
            "enum": [
              "invoices",
              "receipts",
              "credits",
              "policy"
            ]
          }
        },
        "required": [
          "source_id",
          "locator"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "executed_actions": {
      "maxItems": 0,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "balance_sgd": {
          "type": "string"
        },
        "detail_file": {
          "type": "string"
        },
        "eligible_rows": {
          "type": "integer"
        },
        "invoice_ids_preserved": {
          "type": "boolean"
        },
        "unallocated_sgd": {
          "type": "string"
        },
        "unmatched_sgd": {
          "type": "string"
        },
        "workbook": {
          "type": "string"
        }
      },
      "required": [
        "balance_sgd",
        "detail_file",
        "eligible_rows",
        "invoice_ids_preserved",
        "unallocated_sgd",
        "unmatched_sgd",
        "workbook"
      ],
      "type": "object"
    },
    "scenario_id": {
      "const": "B20.scale"
    },
    "schema_version": {
      "const": "RECON-0.1"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "summary",
    "result",
    "citations",
    "executed_actions"
  ],
  "title": "新编候选输出契约；无期望答案",
  "type": "object"
}
