      "role": "textbox",
      "name": "Search resources"
    },
    "sort": {
      "role": "combobox",
      "name": "Resource sort"
    },
    "reset": {
      "role": "button",
      "name": "Reset view"
    },
    "export": {
      "role": "button",
      "name": "Export capacity CSV"
    },
