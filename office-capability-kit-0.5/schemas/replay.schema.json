{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "final": {
      "$ref": "candidate.schema.json"
    },
    "schema_version": {
      "const": "0.5.0"
    },
    "source_provider_kind": {
      "type": "string"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "type": "object"
          },
          "tool": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "arguments"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "steps",
    "final"
  ],
  "title": "Recorded action tape; responses are never trusted or imported",
  "type": "object"
}
