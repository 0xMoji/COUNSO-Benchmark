{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "$ref": "tool-event.schema.json"
      },
      "type": "array"
    },
    "evidence_provenance": {
      "enum": [
        "LOCAL_EXECUTED",
        "EXTERNAL_UNVERIFIED"
      ]
    },
    "schema_version": {
      "const": "0.5.0"
