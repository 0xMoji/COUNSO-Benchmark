{
  "schema_version": "standalone-actions-1",
  "optional": true,
  "scope": "Visible accessibility controls and semantic columns. Alternative legitimate names/columns can be mapped; absent mapping is an integration defect, not a material business error.",
  "dashboard": {
    "team": {
      "role": "combobox",
      "name": "Team"
    },
    "created_from": {
      "label": "Created from"
    },
    "created_to": {
      "label": "Created to"
    },
    "reset": {
      "role": "button",
      "name": "Reset filters"
    },
    "refresh": {
      "role": "button",
      "name": "Refresh data"
    },
    "retry": {
      "role": "button",
      "name": "Retry load"
    },
    "chart_status": {
      "role": "button",
      "name": "Select {status}"
    },
    "status_filter": {
      "role": "checkbox",
      "name": "{status}"
    },
    "tickets": {
      "role": "table",
      "name": "Tickets",
      "columns": {
        "ticket_id": "Ticket ID",
        "team_id": "Team ID",
        "status": "Status",
        "due_at": "Due time UTC",
        "remaining_minutes": "Remaining minutes"
      }
    },
    "metrics": {
      "ticket_count": {
        "label": "Ticket count",
        "unit": "tickets"
      },
      "active_count": {
        "label": "Active count",
