      },
      "overdue_active_count": {
        "label": "Overdue active count",
        "unit": "tickets"
      },
      "remaining_effort_hours": {
        "label": "Remaining effort",
        "unit": "hours"
      }
    },
    "chart_count": {
      "label": "{status} count"
    },
    "chart_plot": {
      "label": "{status} plot"
    },
    "chart_glyph": {
      "label": "{status} plotted count"
    },
    "displayed_scope": {
      "role": "region",
      "name": "Displayed scope"
    },
    "chart_axis": "height"
  },
  "planner": {
    "team": {
      "role": "combobox",
      "name": "View team"
    },
    "view_date": {
      "label": "View date"
    },
